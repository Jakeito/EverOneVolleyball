# Discord application credentials
# Create an application at https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Guild (server) ID the bot operates in. Used to register slash commands instantly.
DISCORD_GUILD_ID=

# Channel ID the bot is allowed to run polls / parse +/- messages in.
VOLLEYBALL_CHANNEL_ID=

# Optional: role ID that is allowed to approve/reject pending guest requests,
# in addition to anyone with the "Manage Messages" permission.
ADMIN_ROLE_ID=

# Max number of players (members + guests) before the waitlist kicks in.
ROSTER_CAP=30

# Cron schedule (server local time) for the automatic Wednesday roster post.
# Default: every Wednesday at 6:00 PM.
GENERATE_LIST_CRON=0 18 * * 3
TIMEZONE=America/Los_Angeles
